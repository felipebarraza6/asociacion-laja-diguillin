---
interface Props {
  kicker: string;
  title: string;
  lede: string;
}
const { kicker, title, lede } = Astro.props;
---

<header class="border-b border-line bg-surface">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <p class="kicker">{kicker}</p>
    <h1 class="mt-3 max-w-4xl font-display text-4xl text-canal sm:text-5xl">{title}</h1>
    <p class="mt-5 max-w-3xl text-lg leading-relaxed text-muted">{lede}</p>
  </div>
</header>
